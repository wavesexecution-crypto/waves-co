# ─────────────────────────────────────────────────────────────────────────────
# Acquisition OS — production environment contract
#
# Copy to .env.local / configure in Vercel. NEVER commit real values.
# Required vs Optional is stated per variable. Nothing here is a placeholder
# that "works by default" — a missing required value fails closed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Pooled connection used by the application runtime. Must be the NON-owner
# role (wavesco_app) so Row-Level Security is actually enforced.
DATABASE_URL=            # REQUIRED
# Direct, non-pooled connection used by Prisma migrations only.
DIRECT_URL=              # REQUIRED (migrations)

# ── Auth ────────────────────────────────────────────────────────────────────
# >= 32 chars. Shared with JWT signing. Rotating it invalidates all sessions.
AUTH_SECRET=             # REQUIRED
# Legacy aliases accepted by lib/auth.ts; set them equal to AUTH_SECRET.
NEXTAUTH_SECRET=         # REQUIRED (same value as AUTH_SECRET)
JWT_SECRET=              # REQUIRED (same value as AUTH_SECRET)
# Canonical origin of the app. Used to build password-reset links.
NEXTAUTH_URL=            # REQUIRED  e.g. https://app.wavesco.in
# Share the cookie across wavesco.in / app.wavesco.in for single sign-on.
NEXTAUTH_COOKIE_DOMAIN=  # OPTIONAL e.g. .wavesco.in

# ── Payments — Razorpay (the only checkout) ─────────────────────────────────
RAZORPAY_KEY_ID=         # REQUIRED — public id, safe for the browser
RAZORPAY_KEY_SECRET=     # REQUIRED — server only, never returned to a client
# Webhook secret from the Razorpay dashboard. REQUIRED for /api/billing/razorpay/webhook.
# Without it the route returns 503: payments taken with the tab closed would
# not be reconciled. This is the single most important variable in this list.
RAZORPAY_WEBHOOK_SECRET= # REQUIRED for payment reconciliation

# ── Email ───────────────────────────────────────────────────────────────────
# Without this, every outbound send fails honestly with
# "Email provider not configured" and the customer is notified.
RESEND_API_KEY=          # REQUIRED for outreach sending
# Verified sender identity. Must be a domain you control on Resend.
SMTP_FROM=               # OPTIONAL e.g. WAVES <outreach@wavesco.in>

# ── AI — Ollama Cloud (cycle intelligence) ──────────────────────────────────
# Without this, AI jobs stay PENDING/retryable and visible; deterministic
# paths (template drafts, metrics, reports) keep working. With it, email
# variants, reply classification, directions and cycle narratives generate.
OLLAMA_API_KEY=        # REQUIRED for AI features — Ollama Cloud key (Authorization: Bearer)
OLLAMA_MODEL=          # OPTIONAL, default gemma4:31b-cloud
OLLAMA_BASE_URL=       # OPTIONAL, default https://ollama.com/api

# ── Infrastructure (not required by the current customer journey) ───────────
# n8n is deployed infrastructure. No runtime code path calls it today, so these
# are unused until a workflow is genuinely wired.
N8N_BASE_URL=            # UNUSED TODAY — https://n8n.wavesco.in
N8N_WEBHOOK_SECRET=      # UNUSED TODAY

# ── Deliberately absent ─────────────────────────────────────────────────────
# STORAGE_ENCRYPTION_KEY : not required — no storage is used in the current journey
# PAYPAL_*               : PayPal was removed rather than shipped half-built;
#                          a second, incomplete checkout is worse than none