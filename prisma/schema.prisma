generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// Platform models. Module tables are added by each CafeOS module in
// Phase 6 (each carries a tenantId column + RLS policy).
//
// RLS: the runtime role `wavesco_app` does NOT own these tables, so
// row-level security (applied in migrations) is enforced for app
// traffic. `withTenantContext()` sets `SET LOCAL app.tenant_id` inside
// a transaction; all app queries must run within that context.
// ------------------------------------------------------------------

model Tenant {
  id   String @id @default(cuid())
  name String
  slug String @unique
  // Acquisition OS is one complete product — no tiers. This field is
  // retained for compatibility and must NOT drive access. All access is
  // driven by AcquisitionEntitlement via lib/billing.ts.
  plan   String @default("one")
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  modules                 TenantModule[]
  idempotency             IdempotencyKey[]
  refreshTokens           RefreshToken[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  entitlements          AcquisitionEntitlement[]
  acquisitionOrders     AcquisitionOrder[]
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  name          String?
  passwordHash  String?
  role          String    @default("owner")
  emailVerified DateTime?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Module {
  id           String  @id @default(cuid())
  name         String  @unique
  displayName  String
  description  String?
  version      String
  contractPath String

  tenants TenantModule[]

  createdAt DateTime @default(now())
}

model TenantModule {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId   String
  module     Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status     String    @default("enabled")
  config     Json?
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, moduleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  model     String
  recordId  String?
  before    Json?
  after     Json?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([model, recordId])
  @@index([createdAt])
}

model IdempotencyKey {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope     String
  key       String
  response  Json?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([tenantId, scope, key])
  @@index([expiresAt])
}

// Auth.js verification tokens (magic link). Auth-level table, not
// tenant-scoped; permissive RLS is applied by the migration.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@index([expires])
}

// ==================================================================
// WavesCo product models (2026-08). All carry tenantId + RLS policy
// applied by migration 20260825010000_wavesco_product_models.
// ==================================================================

// --- Acquisition OS -----------------------------------------------------
model GenerationBatch {
  id              String    @id @default(cuid())
  tenantId        String
  requestId       String    @unique
  params          Json
  status          String    @default("queued")
  stage           String?
  requestedCount  Int?
  resultLeadCount Int?
  emailReadyCount Int?
  engineBatchId   String?
  pdfPath         String?
  excelPath       String?
  logTail         String?
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, status])
}

model Campaign {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  location         String?
  category         String?
  tier             String?
  status           String    @default("draft")
  sendingLimit     Int?
  scheduledFor     DateTime?
  eligibleSnapshot Json?
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, status])
}

model OutreachEmail {
  id          String    @id @default(cuid())
  tenantId    String
  campaignId  String?
  leadKey     String
  business    String
  email       String
  subject     String
  body        String
  status      String    @default("draft")
  approvalId  String?
  messageId   String?
  error       String?
  submittedAt DateTime?
  decidedAt   DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, campaignId])
  @@index([tenantId, leadKey])
}

model FollowUp {
  id              String         @id @default(cuid())
  tenantId        String
  leadKey         String?
  business        String
  dueAt           DateTime
  status          String         @default("pending")
  note            String?
  channel         String         @default("email")
  campaignId      String?
  outreachEmailId String?
  outreachOrderId String?
  followUpNumber  Int            @default(1) @map("follow_up_number")
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  outreachOrder   OutreachOrder? @relation(fields: [outreachOrderId], references: [id])

  @@index([tenantId, status, dueAt])
}

// --- Outreach Order Pipeline (Lead Intelligence → Email Outreach) -------
// Research snapshot per lead, traceable to the engine corpus. One row per
// (tenant, leadKey): refreshed in place, never duplicated.
model LeadResearch {
  id              String    @id @default(cuid())
  tenantId        String
  leadKey         String
  engineLeadId    Int?
  business        String
  category        String?
  area            String?
  city            String?
  website         String?
  instagram       String?
  rating          Float?
  reviews         Int?
  tier            String?
  leadScore       Int?
  digitalPresence String?
  problem         String?
  opportunity     String?
  serviceFit      String?
  angleSeed       String?
  contactName     String?
  contactRole     String?
  email           String?
  sourceUrls      Json?
  verification    String?
  notes           String?
  researchedAt    DateTime  @default(now())
  checkedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, leadKey])
  @@index([tenantId, researchedAt])
}

// Persistent cold-email order for one eligible lead. Lifecycle:
// READY_FOR_APPROVAL → PENDING → APPROVED → SENT → DELIVERED/FAILED,
// with REJECTED / CANCELLED terminal states.
model OutreachOrder {
  id                     String    @id @default(cuid())
  tenantId               String
  version                Int       @default(1)
  leadKey                String
  engineLeadId           Int?
  businessName           String
  contactName            String?
  contactRole            String?
  email                  String
  emailStatus            String    @default("VERIFIED")
  researchSnapshot       Json
  opportunity            String?
  outreachAngle          String?
  subject                String
  body                   String
  followupPlan           Json
  plannerModel           String?
  confidence             String    @default("medium")
  status                 String    @default("READY_FOR_APPROVAL")
  approvalId             String?
  sendId                 String?
  // Cycle + template provenance for cycle-scoped reporting. Nullable so
  // pre-cycle rows keep working; set at import/send time for new rows.
  cycleId                String?
  templateVersion        Int?
  messageVariant         String?
  // Concurrency claim for outbound sends. Set by the single sender that wins
  // the compare-and-set; cleared when a send fails or completes, and treated
  // as reclaimable once stale so a crashed send cannot wedge an order forever.
  sendClaimedAt          DateTime? @map("send_claimed_at")
  sendAttempts           Int       @default(0)
  deliveryStatus         String?
  replyStatus            String?
  sendError              String?
  senderIdentity         String?
  aiEnabled              Boolean   @default(false) @map("ai_enabled")
  aiModel                String?   @map("ai_model")
  enrichmentStatus       String?   @map("enrichment_status")
  selectedService        String?   @map("selected_service")
  personalizationContext Json?     @map("personalization_context")
  submittedAt            DateTime?
  decidedAt              DateTime?
  sentAt                 DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  followups       FollowUp[]
  lifecycleEvents LeadLifecycleEvent[]

  @@unique([tenantId, leadKey, version])
  @@index([tenantId, status])
  @@index([tenantId, email])
}

// Per-lead lifecycle event for full observability. One row per decision point.
model LeadLifecycleEvent {
  id               String   @id @default(cuid())
  tenantId         String
  leadKey          String
  batchId          String?
  stage            String
  status           String
  reason           String?
  aiEnabled        Boolean  @default(false)
  aiProvider       String?
  aiModel          String?
  enrichmentStatus String?
  emailStatus      String?
  eligibility      String?
  orderId          String?
  approvalId       String?
  createdAt        DateTime @default(now())

  outreachOrder OutreachOrder? @relation(fields: [orderId], references: [id])

  @@index([tenantId, leadKey])
  @@index([tenantId, stage])
  @@index([tenantId, createdAt])
  @@index([batchId])
  @@map("LeadLifecycleEvent")
}

model ActivityEvent {
  id         String   @id @default(cuid())
  tenantId   String
  type       String
  title      String
  entityType String?
  entityId   String?
  href       String?
  metadata   Json?
  sourceKey  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, sourceKey])
}

// --- Client OS ----------------------------------------------------------
model Client {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  company       String?
  email         String?
  phone         String?
  status        String   @default("lead")
  notes         String?
  sourceLeadKey String?
  ownerUserId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
}

model OnboardingStep {
  id        String    @id @default(cuid())
  tenantId  String
  clientId  String
  seq       Int
  title     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, clientId])
}

model Project {
  id          String    @id @default(cuid())
  tenantId    String
  clientId    String
  name        String
  description String?
  status      String    @default("planning")
  startDate   DateTime?
  dueDate     DateTime?
  budgetPaise Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, clientId])
}

model ProjectTask {
  id             String    @id @default(cuid())
  tenantId       String
  projectId      String
  title          String
  status         String    @default("todo")
  priority       String    @default("medium")
  dueDate        DateTime?
  completedAt    DateTime?
  assigneeUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, projectId, status])
}

model Deliverable {
  id          String    @id @default(cuid())
  tenantId    String
  projectId   String
  title       String
  type        String?
  status      String    @default("draft")
  dueDate     DateTime?
  deliveredAt DateTime?
  link        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, projectId, status])
}

// --- Automation OS ------------------------------------------------------
model IntegrationStatus {
  id            String    @id @default(cuid())
  tenantId      String
  key           String
  state         String
  detail        String?
  lastCheckedAt DateTime  @default(now())
  lastOkAt      DateTime?

  @@unique([tenantId, key])
}

// --- Waves AI Gateway ---------------------------------------------------
// One AI configuration per tenant (current strategy: one client -> one
// dedicated Ollama account). credentialRef is a REFERENCE (e.g. "env:VAR")
// resolved server-side; secrets never live in the database.
model ClientAiConfig {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  aiEnabled     Boolean  @default(false)
  provider      String   @default("ollama_cloud")
  baseUrl       String?
  model         String?
  credentialRef String?
  obsidianRoot  String?
  config        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// Per-tenant usage ledger for every gateway call.
model AiUsageLog {
  id               String   @id @default(cuid())
  tenantId         String
  operation        String
  provider         String
  model            String
  status           String
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  latencyMs        Int?
  error            String?
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
}

// --- Acquisition Brief / Company Acquisition Profile ------------------------
// Canonical client business context — one per tenant, tenant-isolated.
// The OS converts this context into an acquisition operation. No tier gating.
model AcquisitionProfile {
  id                     String                  @id @default(cuid())
  tenantId               String                  @unique
  status                 String                  @default("DRAFT")
  version                Int                     @default(1)
  // 1 COMPANY
  companyName            String?
  website                String?
  industry               String?
  whatWeSell             String?
  productsServices       Json?
  locationsServed        Json?
  businessModel          String?
  // 2 OBJECTIVE
  acquisitionObjective   String?
  primaryObjective       String?
  targetQuantity         Int?
  targetTimeframe        String?
  priorityProductService String?
  // 3 ICP
  icp                    Json?
  // 5 OFFER
  offer                  Json?
  // 6 BRAND
  brand                  Json?
  // 7 INFRA
  integrations           Json?
  // 8 RULES
  rules                  Json?
  readiness              Json?
  activatedAt            DateTime?
  pausedAt               DateTime?
  suspendedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  dataImports            AcquisitionDataImport[]

  @@index([tenantId, status])
  @@map("AcquisitionProfile")
}

model AcquisitionDataImport {
  id        String             @id @default(cuid())
  tenantId  String
  profileId String
  profile   AcquisitionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fileName  String
  fileType  String
  rowCount  Int?
  status    String             @default("pending")
  summary   Json?
  error     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([tenantId, profileId])
  @@index([tenantId, status])
  @@map("AcquisitionDataImport")
}

// --- Waves Identity — cross-site handoff (single-use, short-lived, cryptographically protected) ---
// Used for explicit "Open App" handoff when shared cookie is not present.
// The JWT itself is signed with JWT_SECRET/AUTH_SECRET, carries jti, aud=app.wavesco.in, destination.
// The row tracks single-use and prevents replay; handoff never puts secrets in URL query.
model WavesHandoffToken {
  id          String    @id @default(cuid())
  jti         String    @unique
  tenantId    String
  userId      String
  destination String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([expiresAt])
  @@map("WavesHandoffToken")
}

// --- Notifications ---------------------------------------------------
model Notification {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  eventType      String // enum value like "CYCLE_STARTED", "LEAD_GENERATION_COMPLETED", etc.
  title          String
  message        String
  cycleId        String?
  campaignId     String?
  resourceType   String? // "lead_report", "campaign", "email_review", "response", "follow_up", "cycle_report"
  resourceId     String?
  resourceHref   String? // client-facing URL path like "/acquisition/cycles/xxx/leads"
  channel        String    @default("in_app") // "in_app", "email", "push"
  read           Boolean   @default(false)
  readAt         DateTime?
  delivered      Boolean   @default(false)
  deliveredAt    DateTime?
  idempotencyKey String    @unique
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, read, createdAt(sort: Desc)])
  @@index([tenantId, userId])
  @@index([tenantId, eventType])
  @@index([idempotencyKey])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  String // "cycle_milestones", "reports", "campaign_activity", "responses", "action_required"
  channel   String // "in_app", "email", "push"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, category, channel])
  @@index([tenantId])
}

// --- Acquisition Cycle OS (6-step loop) -----------------------------------
// Canonical, tenant-scoped cycle state. Database is the source of truth;
// Ollama and n8n are workers that read jobs and write validated results.
// Historical cycles are immutable: no update/delete API exists for closed
// cycles, templates keep versions, goals are cloned (never mutated).

// STEP 1 — persistent Company Brain. One canonical row per tenant,
// produced either by intake (AcquisitionProfile) or Obsidian import.
// Both paths write the SAME payload shape (see lib/brain.ts).
model CompanyBrain {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  source    String   @default("intake") // intake | obsidian | merged
  version   Int      @default(1)
  status    String   @default("draft") // draft | active
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions CompanyBrainRevision[]

  @@index([tenantId, status])
  @@map("CompanyBrain")
}

model CompanyBrainRevision {
  id        String       @id @default(cuid())
  tenantId  String
  brainId   String
  brain     CompanyBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)
  version   Int
  source    String
  payload   Json
  createdAt DateTime     @default(now())

  @@index([tenantId, brainId, version])
  @@map("CompanyBrainRevision")
}

// STEP 2..6 container. cycleNumber is per-tenant, assigned atomically.
model AcquisitionCycle {
  id          String   @id @default(cuid())
  tenantId    String
  cycleNumber Int
  status      String   @default("ACTIVE") // ACTIVE | CLOSED
  goalId      String?
  sendProvider String  @default("waves") // waves | custom (see lib/email-provider.ts)
  startedAt   DateTime @default(now())
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goals     CycleGoal[]
  templates MessageTemplate[]
  aiJobs    AiJob[]
  n8nJobs   N8nJob[]
  reports   ReplyReport[]
  cycleReport CycleReport?

  @@unique([tenantId, cycleNumber])
  @@index([tenantId, status])
  @@map("AcquisitionCycle")
}

// STEP 2 — cycle-specific goal. Cloned rows carry sourceGoalId; history is
// never mutated (code refuses writes once the cycle is CLOSED).
model CycleGoal {
  id             String   @id @default(cuid())
  tenantId       String
  cycleId        String
  cycle          AcquisitionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  title          String
  audience       String?
  segment        String?
  geography      String?
  companyTraits  Json?
  qualification  Json?
  exclusions     Json?
  outcome        String?
  angle          String?
  constraints    Json?
  status         String   @default("active") // active | archived
  source         String   @default("new") // new | clone
  sourceGoalId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, cycleId])
  @@map("CycleGoal")
}

// STEP 3 — message template versions. Approval is explicit; edits create new
// versions; approved versions are never mutated.
model MessageTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  cycleId   String
  cycle     AcquisitionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  version   Int      @default(1)
  subject   String
  opening   String?
  body      String
  cta       String?
  structure Json?
  variants  Json?
  status    String   @default("draft") // draft | approved
  source    String   @default("manual") // manual | deterministic | ai
  aiJobId   String?
  approvedAt DateTime?
  approvedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, version])
  @@index([tenantId, cycleId, status])
  @@map("MessageTemplate")
}

// Async AI work. PENDING -> PROCESSING -> COMPLETED, or PROCESSING ->
// FAILED -> RETRY_PENDING -> PROCESSING. Leased claims make recovery safe;
// idempotencyKey makes retries safe. Results are validated before persist.
model AiJob {
  id             String    @id @default(cuid())
  tenantId       String
  cycleId        String?
  cycle          AcquisitionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  operation      String    // BRAIN_ANALYSIS | GOAL_ANALYSIS | EMAIL_GENERATION | REPLY_CLASSIFICATION | REPLY_SUMMARY | REPLY_DIRECTION | CYCLE_ANALYSIS | LEAD_ANALYSIS
  model          String
  attempt        Int       @default(0)
  maxAttempts    Int       @default(5)
  idempotencyKey String    @unique
  inputRef       Json
  status         String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | RETRY_PENDING
  leaseClaimedAt DateTime?
  result         Json?
  error          String?
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status, nextRetryAt])
  @@index([idempotencyKey])
  @@map("AiJob")
}

// n8n automation bridge. The OS database stays authoritative: n8n receives
// signed events and reports back; jobs survive n8n outages as retryable.
model N8nJob {
  id             String    @id @default(cuid())
  tenantId       String
  cycleId        String?
  cycle          AcquisitionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  event          String
  payload        Json
  status         String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | RETRY_PENDING
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  result         Json?
  lastError      String?
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status, nextRetryAt])
  @@index([idempotencyKey])
  @@map("N8nJob")
}

// Exactly-once log for inbound n8n webhook events.
model N8nEvent {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String   @unique
  jobId     String?
  event     String
  outcome   String   @default("applied") // applied | duplicate | rejected
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("N8nEvent")
}

// STEP 5 — Reply Intelligence. One live report per order (upsert on new
// inbound content); direction/takeover are separate persisted actions.
model ReplyReport {
  id                   String    @id @default(cuid())
  tenantId             String
  cycleId              String?
  cycle                AcquisitionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  orderId              String
  leadKey              String?
  prospectName         String?
  company              String?
  replyText            String?
  replyReceivedAt      DateTime?
  replyStatus          String    @default("UNCLASSIFIED") // UNCLASSIFIED | INTERESTED | NEUTRAL | OBJECTION | NOT_INTERESTED
  intent               String    @default("Unknown") // High | Medium | Low | Unknown
  sentiment            String    @default("Unknown") // Positive | Neutral | Negative | Unknown
  summary              String?
  signals              Json?
  objections           Json?
  askingFor            String?
  recommendedAction    String?
  recommendedDirection String?
  source               String    @default("manual") // manual | ai
  aiJobId              String?
  takenOverAt          DateTime?
  takenOverBy          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  directions ReplyDirection[]

  @@unique([tenantId, orderId])
  @@index([tenantId, cycleId])
  @@map("ReplyReport")
}

model ReplyDirection {
  id            String      @id @default(cuid())
  tenantId      String
  replyReportId String
  report        ReplyReport @relation(fields: [replyReportId], references: [id], onDelete: Cascade)
  kind          String      // answer | qualify | inform | book | custom | takeover
  customText    String?
  draftResponse String?
  status        String      @default("pending") // pending | acknowledged | done
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId, replyReportId])
  @@map("ReplyDirection")
}

// STEP 6 — immutable cycle report. Metrics are deterministic; narrative is
// AI-interpreted and validated. Exactly one row per cycle; no update API.
model CycleReport {
  id            String   @id @default(cuid())
  tenantId      String
  cycleId       String   @unique
  cycle         AcquisitionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleNumber   Int
  metrics       Json
  narrative     Json?
  narrativeJobId String?
  status        String   @default("final") // final | final_metrics_pending_narrative
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("CycleReport")
}

// STEP 4 — client-owned sending credential. The provider API key is NEVER
// stored in plaintext: AES-256-GCM with the server-only AUTH_SECRET (see
// lib/email-provider.ts). Only label + last4 + verification state live here
// in the clear. One credential per tenant; disconnect deletes the row.
model EmailCredential {
  id         String    @id @default(cuid())
  tenantId   String    @unique
  provider   String    @default("resend")
  label      String?
  keyLast4   String?
  keyCipher  String?
  keyIv      String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@map("EmailCredential")
}

// --- Billing / Lease (Acquisition OS) — ONE product, lease duration only, no tiers
model AcquisitionEntitlement {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        String    @default("acquisition_os")
  status         String    // TRIAL, TRIAL_EXPIRED, ACTIVE, EXPIRED, CANCELLED, REFUNDED
  leaseType      String?   // TRIAL_2D, LEASE_30, LEASE_90, LEASE_180, LEASE_365
  trialStartedAt DateTime?
  trialExpiresAt DateTime?
  startedAt      DateTime?
  expiresAt      DateTime?
  pricePaise     Int?
  currency       String    @default("INR")
  orderId        String?
  paymentId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("AcquisitionEntitlement")
}

model AcquisitionOrder {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaseType       String   // LEASE_30/90/180/365 (trial has no order)
  amountPaise     Int      // server-computed locked price
  currency        String   @default("INR")
  status          String   // CREATED, PAYMENT_PENDING, PAYMENT_VERIFIED, PAYMENT_FAILED, CANCELLED
  provider        String   @default("RAZORPAY")
  providerOrderId String?  @unique
  paymentId       String?
  signature       String?
  idempotencyKey  String   @unique
  meta            Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([providerOrderId])
  @@index([idempotencyKey])
  @@map("AcquisitionOrder")
}

